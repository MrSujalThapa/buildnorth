PM_ENVIRONMENT=development
PM_LOG_LEVEL=INFO
# Local CLI default only. Render staging/production must use the hosted
# Supabase session-mode URL already configured as PM_DATABASE_URL (port 5432,
# sslmode=require). Do not migrate 127.0.0.1:54322 in place of that database.
# Do not run `supabase db push` blindly; inspect schema_migrations first.
PM_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
PM_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
PM_CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+):\d+$
# Public URLs advertised to MCP clients. Local defaults are loopback.
# Staging must set HTTPS values that match the deployed API and web origins.
PM_PUBLIC_API_URL=http://127.0.0.1:8000
PM_PUBLIC_WEB_URL=http://localhost:5173
# Frontend build-time API origin. Empty uses the current hostname on port 8000.
VITE_API_BASE_URL=
PM_OPENAI_API_KEY=
PM_OPENAI_MODEL=
PM_INFERENCE_PROVIDER=spur
# Optional default model and per-agent overrides. Empty model retains legacy agent models.
# Hosted inference is Spur-only. OpenAI and Anthropic are BYOK providers.
PM_INFERENCE_MODEL=spur-deepseek-v4-flash
PM_INFERENCE_AGENT_OVERRIDES={}
PM_INFERENCE_MAX_INPUT_BYTES=48000
PM_INFERENCE_RUN_TIMEOUT_SECONDS=120
# Server-only encryption key ring: JSON of key IDs to URL-safe base64 32-byte AES keys.
# Generate securely; do not reuse provider keys. Keep old keys for backup/rotation recovery.
PM_BYOK_ENCRYPTION_KEYS={}
PM_BYOK_ACTIVE_KEY_ID=v1
PM_ANTHROPIC_API_KEY=
PM_SPUR_API_KEY=
SPUR_API_KEY=
SPUR_BASE_URL=https://ai.spuric.com/v1
PM_SPUR_MODEL=spur-deepseek-v4-flash
PM_OPENAI_GOAL_MODEL=gpt-5.4-mini
PM_OPENAI_EVIDENCE_MODEL=gpt-5.4-nano
PM_OPENAI_RESEARCH_MODEL=gpt-5.4-mini
PM_OPENAI_CRITIC_MODEL=gpt-5.4
PM_OPENAI_BASELINE_MODEL=gpt-5.4
PM_OPENAI_MAX_COST_USD=100.0
PM_GITHUB_TOKEN=
PM_MONID_ENABLED=false
PM_MONID_API_BASE=
PM_MONID_CLIENT_ID=
# API-key authentication replaces the old inactive client-id stub.
PM_MONID_API_KEY=
PM_MONID_TOOL_PROVIDER=tinyfish
PM_MONID_TOOL_ENDPOINT=/search
PM_MONID_TOOL_INPUT_TEMPLATE={"queryParams":{"query":"{query}","domain_type":"research_paper"}}
PM_MONID_MAX_CALLS=5
PM_MONID_TIMEOUT_SECONDS=25
PM_MONID_MAX_COST_USD=0.02
# Optional override. By default the web app uses its current hostname on port 8000.
PM_DEV_DEMO_FIXTURES=false
# Enable SimulationCloud rendering for DEMO_SEED points in receipt (dev only).
VITE_DEV_DEMO_SIMULATIONS=false

# Clerk (required for hosted sign-in). Enable Google under Clerk Dashboard → SSO connections.
# Official Vite frontend key. Clerk CLI writes this name; never prefix the secret with VITE_.
VITE_CLERK_PUBLISHABLE_KEY=
# Official Clerk backend secret. FastAPI verifies session JWTs via JWKS, not this key.
# Keep it in the repo .env for `npx clerk` tooling. Do not rename to VITE_CLERK_SECRET_KEY.
# CLERK_SECRET_KEY=
PM_CLERK_JWKS_URL=
PM_CLERK_ISSUER=
PM_CLERK_AUTHORIZED_PARTIES=["http://localhost:5173","http://127.0.0.1:5173"]
PM_ADMIN_EMAILS=["admin@example.com"]
PM_ADMIN_CLERK_USER_IDS=[]
PM_TEST_AUTH_SECRET=
PM_HOSTED_INFERENCE_ENABLED=true
PM_HOSTED_USER_QUOTA_USD=5.0
PM_HOSTED_ADMIN_QUOTA_USD=100.0
PM_HOSTED_USER_QUOTA_TOKENS=5000000
PM_HOSTED_GLOBAL_QUOTA_USD=250.0
PM_HOSTED_GLOBAL_QUOTA_TOKENS=250000000
PM_HOSTED_USER_RPM=20
PM_HOSTED_IP_RPM=60
PM_INVITE_TTL_HOURS=72
PM_INVITE_MAX_REDEMPTIONS=20
# Local/e2e only. Never enable for public deployments. Startup fails closed if
# this or PM_TEST_AUTH_SECRET is set on staging/production, or when
# PM_PUBLIC_API_URL is a public HTTPS hostname.
PM_DEV_BOOTSTRAP_TEST_USERS=false
# Staging behind a reverse proxy that overwrites X-Forwarded-For. Default false.
PM_TRUST_FORWARDED_HEADERS=false
PM_TRUSTED_PROXIES=["127.0.0.1","::1"]
VITE_AUTH_BYPASS=false
VITE_TEST_AUTH_TOKEN=

# Hosted inference is Spur-funded. Application counters are $5/user and $100 global.
# These are estimated application caps, not upstream Spur billing hard limits.
# Single Uvicorn worker is required: MCP rate limits and goal write locks are
# process-local and are not multi-worker safe.
# Isolated Postgres tests need a database with migrations 0001-0016 applied:
#   PM_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/playitout_e2e
# Evaluation scripts under scripts/ (evaluate_openai_baseline, eval_hackathon_proof,
# eval_pass6_live_ablation) are CLI-only and must not be wired into API routes.
