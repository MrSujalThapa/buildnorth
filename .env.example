PM_ENVIRONMENT=development
PM_LOG_LEVEL=INFO
PM_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
PM_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
PM_CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+):\d+$
PM_OPENAI_API_KEY=
PM_OPENAI_MODEL=
PM_OPENAI_GOAL_MODEL=gpt-5.4-mini
PM_OPENAI_EVIDENCE_MODEL=gpt-5.4-nano
PM_OPENAI_RESEARCH_MODEL=gpt-5.4-mini
PM_OPENAI_CRITIC_MODEL=gpt-5.4
PM_OPENAI_BASELINE_MODEL=gpt-5.4
PM_OPENAI_MAX_COST_USD=5.0
PM_GITHUB_TOKEN=
PM_MONID_ENABLED=false
PM_MONID_API_BASE=
PM_MONID_CLIENT_ID=
# Optional override. By default the web app uses its current hostname on port 8000.
PM_DEV_DEMO_FIXTURES=true
# Enable SimulationCloud rendering for DEMO_SEED points in receipt (dev only).
VITE_DEV_DEMO_SIMULATIONS=true
