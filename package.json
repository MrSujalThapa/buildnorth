{
  "name": "personal-markets",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/web"],
  "scripts": {
    "setup": "npm install && uv sync",
    "dev": "npm run dev --workspace @personal-markets/web -- --host 0.0.0.0",
    "dev:api": "uv run python -m personal_markets --host 0.0.0.0 --port 8000",
    "lint": "npm run lint --workspace @personal-markets/web && uv run ruff check .",
    "typecheck": "npm run typecheck --workspace @personal-markets/web && uv run mypy",
    "test": "npm run test --workspace @personal-markets/web && uv run pytest",
    "build": "npm run build --workspace @personal-markets/web",
    "test:e2e:submission": "npm run test:e2e:submission --workspace @personal-markets/web",
    "test:e2e:live": "npm run test:e2e:live --workspace @personal-markets/web",
    "verify:submission": "uv run python scripts/verify_submission.py",
    "demo:preflight": "uv run python scripts/demo_preflight.py",
    "demo:start": "uv run python scripts/demo_start.py",
    "evaluate:agents": "uv run python scripts/evaluate_agents.py",
    "agents:export-trajectories": "uv run python scripts/export_agent_trajectories.py",
    "evaluate:openai-baseline": "uv run python scripts/evaluate_openai_baseline.py",
    "evaluate:pass4": "uv run python scripts/evaluate_pass4.py",
    "evaluate:behavior": "uv run python scripts/evaluate_behavior.py",
    "supabase:start": "npx supabase@2.116.0 start",
    "supabase:stop": "npx supabase@2.116.0 stop",
    "db:reset": "npx supabase@2.116.0 db reset",
    "db:migrate": "uv run python scripts/db_migrate.py",
    "seed-demo": "uv run python scripts/seed_demo.py",
    "seed-demo:reset": "npm run db:reset && npm run seed-demo",
    "data:download": "uv run python scripts/download_oulad.py",
    "prepare:oulad": "uv run python scripts/prepare_oulad.py",
    "data:prepare": "uv run python scripts/prepare_oulad.py",
    "evaluate": "uv run python scripts/evaluate.py",
    "check:architecture": "uv run python scripts/check_architecture.py",
    "check:migrations": "uv run python scripts/check_migrations.py"
  }
}
