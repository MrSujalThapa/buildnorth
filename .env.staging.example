# Private staging template. Copy values into Render / Vercel dashboards.
# Do not commit filled copies. Do not point this at the local Supabase CLI
# database on 127.0.0.1:54322.

PM_ENVIRONMENT=staging
PM_LOG_LEVEL=INFO

# Hosted Supabase session-mode Postgres (port 5432), sslmode=require.
# Transaction-mode pooler (port 6543) is incompatible with asyncpg/LangGraph.
PM_DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require

# Public HTTPS origins after Render + Vercel assign them. No trailing slash.
PM_PUBLIC_API_URL=https://REPLACE-API.onrender.com
PM_PUBLIC_WEB_URL=https://REPLACE-WEB.vercel.app
PM_CORS_ORIGINS=["https://REPLACE-WEB.vercel.app"]
PM_CORS_ORIGIN_REGEX=

# Clerk (same instance as local is allowed if origins below are added).
# JWKS and issuer come from Clerk → API keys → Show JWKS / Frontend API.
PM_CLERK_JWKS_URL=https://REPLACE.clerk.accounts.dev/.well-known/jwks.json
PM_CLERK_ISSUER=https://REPLACE.clerk.accounts.dev
PM_CLERK_AUTHORIZED_PARTIES=["https://REPLACE-WEB.vercel.app"]
PM_ADMIN_EMAILS=["admin@example.com"]
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE
CLERK_SECRET_KEY=sk_test_REPLACE

# Hardening. Staging refuses to boot if bootstrap or test auth is on.
PM_DEV_BOOTSTRAP_TEST_USERS=false
PM_TEST_AUTH_SECRET=
PM_DEV_DEMO_FIXTURES=false
VITE_AUTH_BYPASS=false
VITE_TEST_AUTH_TOKEN=
VITE_DEV_DEMO_SIMULATIONS=false

# Frontend build-time API origin (Vercel Environment Variables).
VITE_API_BASE_URL=https://REPLACE-API.onrender.com

# Leave false until the Render peer IP is known and overwrites X-Forwarded-For.
PM_TRUST_FORWARDED_HEADERS=false
PM_TRUSTED_PROXIES=["127.0.0.1","::1"]

# Hosted inference caps. Do not raise for the hackathon.
PM_HOSTED_INFERENCE_ENABLED=true
PM_HOSTED_USER_QUOTA_USD=2.0
PM_HOSTED_GLOBAL_QUOTA_USD=25.0
PM_HOSTED_USER_QUOTA_TOKENS=100000
PM_HOSTED_GLOBAL_QUOTA_TOKENS=1000000
PM_HOSTED_USER_RPM=20
PM_HOSTED_IP_RPM=60

PM_MCP_ENABLED=true
PM_MCP_DYNAMIC_CLIENT_REGISTRATION=true
PM_INVITE_TTL_HOURS=72
PM_INVITE_MAX_REDEMPTIONS=20

# Server-only BYOK ring. Generate new keys for staging; do not reuse local keys
# if this database is distinct.
PM_BYOK_ENCRYPTION_KEYS={}
PM_BYOK_ACTIVE_KEY_ID=v1

# Provider keys: set in the host dashboard, never in git.
PM_SPUR_API_KEY=
PM_OPENAI_API_KEY=
PM_ANTHROPIC_API_KEY=
PM_MONID_ENABLED=false
